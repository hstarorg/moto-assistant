DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moto_assistant
# appId|appSecret
WECHAT_CONFIG='<appId>|<appSecret>'
# offerId|appKey|environment|messageToken|encodingAESKey；留空表示关闭
# environment 只能是 sandbox 或 production
WECHAT_VPAY_CONFIG=''
# accountId|accessKeyId|secretAccessKey|bucket|keyPrefix
R2_CONFIG='<accountId>|<accessKeyId>|<secretAccessKey>|<bucket>|moto_assistant'
