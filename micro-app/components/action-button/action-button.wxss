:host {
  width: 100%;
  display: block;
}

.action-button {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: stretch;
  justify-content: center;
  margin: 0;
  padding: 0 32rpx;
  border: 0;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 500;
  line-height: normal;
}

.action-button::after {
  border: 0;
}

.action-button__content {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-button__label {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.action-button__spinner {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  margin-right: 14rpx;
  border: 3rpx solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
  animation: action-button-spin 0.8s linear infinite;
}

.action-button--primary {
  background: #16794a;
  color: #fff;
}

.action-button--secondary {
  border: 1rpx solid #c9ced5;
  background: #fff;
  color: #30343b;
}

.action-button--danger {
  border: 1rpx solid #d8a5a3;
  background: #fff;
  color: #a51d1a;
}

.action-button--text {
  padding-right: 20rpx;
  padding-left: 20rpx;
  background: transparent;
  color: #16683f;
  font-weight: 600;
}

.action-button--pressed {
  opacity: 0.78;
}

.action-button.action-button--primary[disabled] {
  background: #9bb9aa;
  color: rgba(255, 255, 255, 0.82);
}

.action-button.action-button--secondary[disabled],
.action-button.action-button--danger[disabled],
.action-button.action-button--text[disabled] {
  background: #f1f2f4;
  color: #9aa0a8;
}

@keyframes action-button-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .action-button__spinner {
    animation: none;
  }
}

@media (prefers-color-scheme: dark) {
  .action-button--primary {
    background: #239661;
  }

  .action-button--secondary {
    border-color: #555a62;
    background: #242629;
    color: #f3f5f7;
  }

  .action-button--danger {
    border-color: #865957;
    background: #242629;
    color: #ffaaa6;
  }

  .action-button--text {
    color: #8ce0b5;
  }

  .action-button.action-button--secondary[disabled],
  .action-button.action-button--danger[disabled],
  .action-button.action-button--text[disabled] {
    background: #303236;
    color: #777d86;
  }
}
