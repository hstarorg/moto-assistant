:host {
  width: 100%;
  height: 100%;
  min-height: 0;
  display: block;
}

.page-shell,
.page-shell__content {
  width: 100%;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.page-shell,
.page-shell__content {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.page-shell--padded {
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.page-shell__state {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 48rpx;
  box-sizing: border-box;
  text-align: center;
}

.page-shell__state--page {
  height: 100%;
}

.page-shell__state--section {
  min-height: 720rpx;
}

.page-shell__state--compact {
  min-height: 320rpx;
  padding: 48rpx 24rpx;
}

.page-shell__indicator {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 28rpx;
  border: 4rpx solid #d8eee1;
  border-top-color: #16794a;
  border-radius: 50%;
  animation: page-shell-spin 0.8s linear infinite;
}

.page-shell__title {
  display: block;
  color: #1f2329;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.5;
}

.page-shell__state--compact .page-shell__title {
  font-size: 32rpx;
}

.page-shell__description {
  display: block;
  max-width: 560rpx;
  margin-top: 16rpx;
  color: #606770;
  font-size: 28rpx;
  line-height: 1.65;
}

.page-shell__action {
  width: 320rpx;
  height: 88rpx;
  margin-top: 40rpx;
}

@keyframes page-shell-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .page-shell__indicator {
    animation: none;
  }
}

@media (prefers-color-scheme: dark) {
  .page-shell__title {
    color: #f3f5f7;
  }

  .page-shell__description {
    color: #b6bbc3;
  }

  .page-shell__indicator {
    border-color: #24523d;
    border-top-color: #68d49b;
  }
}
