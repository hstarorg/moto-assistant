.about-scroll {
  width: 100%;
  height: 100%;
}

.about-page {
  width: 100%;
  max-width: 960rpx;
  margin: 0 auto;
  padding: 32rpx 30rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx 48rpx;
  text-align: center;
}

.brand-mark {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: #16794a;
  box-shadow: 0 12rpx 32rpx rgba(22, 121, 74, 0.2);
}

.brand-mark-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.app-name {
  margin-top: 28rpx;
  color: #1f2329;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.4;
}

.app-slogan {
  max-width: 560rpx;
  margin-top: 14rpx;
  color: #5c6370;
  font-size: 28rpx;
  line-height: 1.7;
}

.version-badge {
  margin-top: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #e8f5ed;
  color: #16683f;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  display: block;
  margin: 0 8rpx 16rpx;
  color: #454b54;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.feature-card {
  overflow: hidden;
  border: 1rpx solid #e2e5e9;
  border-radius: 24rpx;
  background: #fff;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 30rpx 28rpx;
}

.feature-index {
  width: 64rpx;
  flex: none;
  color: #16794a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.7;
  font-variant-numeric: tabular-nums;
}

.feature-content,
.privacy-content {
  min-width: 0;
  flex: 1;
}

.feature-title,
.privacy-title {
  display: block;
  color: #1f2329;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.feature-desc,
.privacy-desc {
  display: block;
  margin-top: 8rpx;
  color: #606770;
  font-size: 27rpx;
  line-height: 1.65;
}

.feature-divider {
  height: 1rpx;
  margin-left: 92rpx;
  background: #eceef1;
}

.privacy-note {
  display: flex;
  align-items: stretch;
  margin-top: 32rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: #eef7f1;
}

.privacy-accent {
  width: 6rpx;
  flex: none;
  margin-right: 20rpx;
  border-radius: 999rpx;
  background: #16794a;
}

.privacy-title {
  font-size: 28rpx;
}

.privacy-desc {
  color: #4f6258;
  font-size: 26rpx;
}

.page-footer {
  padding: 48rpx 16rpx 8rpx;
  color: #7a818c;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

@media (prefers-color-scheme: dark) {
  .brand-mark {
    background: #239661;
    box-shadow: none;
  }

  .app-name,
  .feature-title,
  .privacy-title {
    color: #f3f5f7;
  }

  .app-slogan,
  .feature-desc {
    color: #b6bbc3;
  }

  .version-badge {
    background: #173c2d;
    color: #8ce0b5;
  }

  .section-title,
  .page-footer {
    color: #aeb4bd;
  }

  .feature-card {
    border-color: #3a3d42;
    background: #242629;
  }

  .feature-divider {
    background: #3a3d42;
  }

  .feature-index {
    color: #68d49b;
  }

  .privacy-note {
    background: #1d3329;
  }

  .privacy-accent {
    background: #68d49b;
  }

  .privacy-desc {
    color: #b4c7bc;
  }
}
