<view class="container">
  <view class="all-data-view">
    <view class="all-data-view-label">累计数据（不含最后一次记录）</view>
    <view class="text-block full">总里程：<text>{{statisticsData.totalMileage}} 公里</text></view>
    <view class="text-block full">总消费：<text>{{statisticsData.totalAmount}} 元</text></view>
    <view class="text-block full">平均油耗：<text>{{statisticsData.avgFuel}} L/100 公里</text></view>
    <view class="text-block full">每公里单价：<text>{{statisticsData.avgPrice}} 元/公里</text></view>
  </view>

  <scroll-view scroll-y class="scroll-view">
    <view wx:if="{{isLoaded && fuelList.length === 0}}" class="empty-state">
      <text class="empty-state-title">还没有加油记录</text>
      <text class="empty-state-desc">点击“添加记录”录入第一次加油信息</text>
    </view>
    <view class="fuel-item" wx:for="{{fuelList}}" wx:key="id">
      <view class="text-block">加油时间：<text>{{item.refuelDate}}</text></view>
      <view class="text-block">当前里程：<text>{{item.currentMileage}} 公里</text></view>
      <view class="text-block">本次消费：<text>￥{{item.refuelAmount}} 元</text></view>
      <view class="text-block">本次油价：<text>￥{{item.unitPrice}} 元/L</text></view>
      <view class="text-block">加油量：<text>{{item.fuelCount}} L</text></view>
    </view>
  </scroll-view>

  <button
    class="btn-add-fuel"
    type="primary"
    aria-label="添加加油记录"
    bindtap="handleAddFuelClick"
  >添加记录</button>

  <view wx:if="{{addModalVisible}}" class="popup-view">
    <view class="popup-view-mask" bindtap="cancelFuelAdd"></view>
    <form
      class="popup-view-panel"
      aria-role="dialog"
      aria-label="添加加油记录"
      bindsubmit="handleAddFuelRecord"
    >
      <view class="popup-view-header">添加加油信息</view>
      <view class="popup-view-body">
        <view class="form-field">
          <view class="section form-item">
            <text class="form-label"><text class="required">*</text>加油时间</text>
            <picker
              class="date-picker"
              value="{{fuelModel.refuelDate}}"
              mode="date"
              end="{{dateNowStr}}"
              aria-label="选择加油时间，必填"
              bindchange="bindDateChange"
            >
              <view class="date-picker-text">{{fuelModel.refuelDate}}</view>
            </picker>
          </view>
          <text wx:if="{{fuelErrors.refuelDate}}" class="form-error" aria-role="alert">
            {{fuelErrors.refuelDate}}
          </text>
        </view>

        <view class="form-field">
          <view class="section form-item">
            <label class="form-label" for="current-mileage"><text class="required">*</text>当前里程</label>
            <input
              id="current-mileage"
              name="currentMileage"
              type="digit"
              maxlength="13"
              placeholder="请输入当前行驶里程"
              value="{{fuelModel.currentMileage}}"
              confirm-type="next"
              aria-label="当前里程，必填"
              bindinput="updateCurrentMileage"
            />
          </view>
          <text wx:if="{{fuelErrors.currentMileage}}" class="form-error" aria-role="alert">
            {{fuelErrors.currentMileage}}
          </text>
        </view>

        <view class="form-field">
          <view class="section form-item">
            <label class="form-label" for="unit-price"><text class="required">*</text>当前油价</label>
            <input
              id="unit-price"
              name="unitPrice"
              type="digit"
              maxlength="11"
              placeholder="请输入今日油价"
              value="{{fuelModel.unitPrice}}"
              confirm-type="next"
              aria-label="当前油价，必填"
              bindinput="updateUnitPrice"
            />
          </view>
          <text wx:if="{{fuelErrors.unitPrice}}" class="form-error" aria-role="alert">
            {{fuelErrors.unitPrice}}
          </text>
        </view>

        <view class="form-field">
          <view class="section form-item">
            <label class="form-label" for="refuel-amount"><text class="required">*</text>消费金额</label>
            <input
              id="refuel-amount"
              name="refuelAmount"
              type="digit"
              maxlength="13"
              placeholder="请输入加油总金额"
              value="{{fuelModel.refuelAmount}}"
              confirm-type="done"
              aria-label="消费金额，必填"
              bindinput="updateRefuelAmount"
            />
          </view>
          <text wx:if="{{fuelErrors.refuelAmount}}" class="form-error" aria-role="alert">
            {{fuelErrors.refuelAmount}}
          </text>
        </view>
      </view>
      <view class="popup-view-footer">
        <button disabled="{{isSubmitting}}" bindtap="cancelFuelAdd">取消</button>
        <button
          type="primary"
          form-type="submit"
          loading="{{isSubmitting}}"
          disabled="{{isSubmitting}}"
        >{{isSubmitting ? '保存中' : '确定保存'}}</button>
      </view>
    </form>
  </view>
</view>
