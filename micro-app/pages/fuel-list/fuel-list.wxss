.all-data-view {
  width: 100%;
  flex: none;
  position: relative;
  margin-bottom: 24rpx;
  padding: 64rpx 20rpx 20rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.all-data-view-label {
  position: absolute;
  top: 0;
  left: 0;
  padding: 10rpx 16rpx;
  border-right: 1rpx solid #dfe3e8;
  border-bottom: 1rpx solid #dfe3e8;
  border-radius: 12rpx 0 8rpx;
  background: #fff6d6;
  color: #3c4043;
  font-size: 26rpx;
}

.scroll-view {
  width: 100%;
  min-height: 0;
  flex: 1;
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.fuel-item {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
  font-size: 28rpx;
}

.text-block {
  display: inline-block;
  width: 50%;
  color: #3c4043;
  font-size: 28rpx;
  line-height: 1.8;
  box-sizing: border-box;
}

.text-block.full {
  width: 100%;
}

.text-block > text {
  color: #9a4100;
  font-variant-numeric: tabular-nums;
}

.btn-add-fuel {
  position: fixed;
  z-index: 10;
  right: 30rpx;
  bottom: 20rpx;
  bottom: calc(20rpx + constant(safe-area-inset-bottom));
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  width: 200rpx;
}

.popup-view {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.popup-view-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
}

.popup-view-panel {
  position: absolute;
  z-index: 1;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 90%;
  overflow-y: auto;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.popup-view-header {
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #dfe3e8;
  color: #1f2329;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.popup-view-body {
  padding: 20rpx 30rpx;
}

.popup-view-footer {
  display: flex;
  padding: 20rpx 22rpx;
  border-top: 1rpx solid #dfe3e8;
}

.popup-view-footer-action {
  flex: 1;
  margin: 0 8rpx;
}
