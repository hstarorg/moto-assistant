.content-container {
  width: 100%;
  box-sizing: border-box;
}

.moto-item {
  width: 100%;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
  color: inherit;
  line-height: normal;
  text-align: left;
}

.moto-item::after {
  border: 0;
}

.moto-item--pressed {
  background: #eef7f1;
  opacity: 0.85;
}

.moto-item-photo {
  width: 128rpx;
  height: 128rpx;
  min-width: 128rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #eef0f2;
}

.moto-item-content {
  min-width: 0;
  flex: 1;
}

.moto-item-name {
  display: block;
  overflow: hidden;
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.moto-item-desc {
  display: block;
  margin-top: 12rpx;
  color: #606770;
  font-size: 28rpx;
  line-height: 1.5;
}

.scroll-view {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.btn-add-area {
  padding: 12rpx 0 8rpx;
}

.btn-add-moto {
  width: 240rpx;
  margin: 0 auto;
}
