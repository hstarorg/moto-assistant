.form-moto {
  width: 100%;
}

.photo-field {
  margin-bottom: 40rpx;
  text-align: center;
}

.photo-picker {
  width: 280rpx;
  height: 280rpx;
  padding: 0;
  border: 2rpx dashed #8a9199;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
  line-height: normal;
}

.photo-picker::after {
  border: 0;
}

.photo-picker--pressed {
  background: #eef7f1;
  opacity: 0.85;
}

.moto-photo {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.photo-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.photo-placeholder-title {
  color: #1f2329;
  font-size: 30rpx;
  font-weight: 600;
}

.photo-placeholder-desc {
  margin-top: 16rpx;
  color: #606770;
  font-size: 24rpx;
  line-height: 1.5;
}

.placeholder {
  color: #80868b;
}

.photo-error {
  display: block;
  min-height: 40rpx;
  padding-top: 8rpx;
  color: #c5221f;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.btn-area {
  margin-top: 32rpx;
}

.privacy-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  padding-bottom: calc(30rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: rgba(0, 0, 0, 0.5);
  box-sizing: border-box;
}

.privacy-dialog {
  width: 100%;
  max-width: 600rpx;
  padding: 40rpx;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
}

.privacy-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.privacy-content {
  color: #3c4043;
  font-size: 28rpx;
  line-height: 1.7;
}

.privacy-contract-button {
  margin-top: 16rpx;
}

.privacy-actions {
  display: flex;
  margin: 36rpx -8rpx 0;
}

.privacy-action {
  flex: 1;
  margin: 0 8rpx;
}
