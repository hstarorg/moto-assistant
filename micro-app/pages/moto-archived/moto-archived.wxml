<page-shell
  state="{{loginStatus === 'ready' ? 'content' : (hasLoginFailed ? 'error' : 'loading')}}"
  title="{{hasLoginFailed ? '暂时无法加载' : '正在加载...'}}"
  description="{{hasLoginFailed ? '服务暂时不可用，请稍后重试。' : '正在连接服务，请稍候'}}"
  action-label="{{hasLoginFailed ? (loginStatus === 'loggingIn' ? '正在加载' : '重试') : ''}}"
  action-aria-label="重试加载已归档车辆"
  action-loading="{{loginStatus === 'loggingIn' && hasLoginFailed}}"
  padded="{{true}}"
  bindaction="handleLoginRetry"
>
  <scroll-view scroll-y class="scroll-view">
    <view class="content-container">
      <page-shell
        wx:if="{{isLoaded && loadFailed}}"
        state="error"
        state-size="compact"
        title="归档车辆加载失败"
        description="请检查网络后重新加载。"
        action-label="重新加载"
        action-loading="{{isLoadingMotos}}"
        bindaction="handleDataRetry"
      ></page-shell>
      <page-shell
        wx:elif="{{isLoaded && motoList.length === 0}}"
        state="empty"
        state-size="compact"
        title="没有已归档车辆"
        description="归档的车辆会显示在这里"
      ></page-shell>
      <block wx:else>
        <view class="moto-item" wx:for="{{motoList}}" wx:key="id">
          <view
            class="moto-item-main"
            aria-label="已归档车辆{{item.motoName}}，车牌号{{item.motoLicensePlate}}"
          >
            <image
              class="moto-item-photo"
              src="{{item.motoPhotoUrl}}"
              mode="aspectFill"
              lazy-load
              aria-hidden="true"
            ></image>
            <view class="moto-item-content">
              <text class="moto-item-name">{{item.motoName}}</text>
              <text class="moto-item-desc">车牌号：{{item.motoLicensePlate}}</text>
            </view>
          </view>
          <view class="moto-item-footer">
            <action-button
              class="moto-item-action"
              variant="text"
              label="{{restoringMotoId === item.id ? '恢复中' : '恢复使用'}}"
              aria-label="恢复{{item.motoName}}"
              loading="{{restoringMotoId === item.id}}"
              disabled="{{restoringMotoId > 0}}"
              data-moto-id="{{item.id}}"
              bindtap="handleRestoreMoto"
            ></action-button>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</page-shell>
