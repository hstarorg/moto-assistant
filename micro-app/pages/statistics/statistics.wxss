.statistics-page,
.statistics-scroll {
  width: 100%;
  height: 100%;
}

.statistics-content {
  width: 100%;
  max-width: 960rpx;
  min-height: 100%;
  margin: 0 auto;
  padding: 30rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-state {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 48rpx;
  box-sizing: border-box;
  text-align: center;
}

.page-state--content {
  min-height: 720rpx;
}

.state-indicator,
.refresh-indicator {
  border: 4rpx solid #d8eee1;
  border-top-color: #16794a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.state-indicator {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 28rpx;
}

.refresh-indicator {
  width: 28rpx;
  height: 28rpx;
}

.state-title {
  display: block;
  color: #1f2329;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.5;
}

.state-desc {
  display: block;
  max-width: 560rpx;
  margin-top: 16rpx;
  color: #606770;
  font-size: 28rpx;
  line-height: 1.65;
}

.state-action {
  min-width: 320rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  padding-top: 0;
  padding-bottom: 0;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.4;
}

.state-action--retry {
  height: 88rpx;
  display: block;
  padding: 0 32rpx;
  line-height: 88rpx;
  text-align: center;
}

.empty-graphic {
  height: 112rpx;
  display: flex;
  align-items: flex-end;
  margin-bottom: 36rpx;
}

.empty-bar {
  width: 28rpx;
  margin: 0 8rpx;
  border-radius: 8rpx 8rpx 2rpx 2rpx;
  background: #b7dfc8;
}

.empty-bar--short {
  height: 44rpx;
}

.empty-bar--medium {
  height: 76rpx;
}

.empty-bar--tall {
  height: 108rpx;
  background: #16794a;
}

.load-notice {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  border: 1rpx solid #e8cf93;
  border-radius: 18rpx;
  background: #fff8e7;
  box-sizing: border-box;
}

.load-notice-text {
  min-width: 0;
  flex: 1;
  color: #6d541d;
  font-size: 26rpx;
  line-height: 1.5;
}

.load-notice-action {
  min-width: 112rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 16rpx;
  padding: 0 20rpx;
  border: 0;
  background: transparent;
  box-sizing: border-box;
  color: #16683f;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.4;
}

.load-notice-action::after {
  border: 0;
}

.summary-card {
  overflow: hidden;
  padding: 34rpx 32rpx 0;
  border-radius: 28rpx;
  background: #176b45;
  box-shadow: 0 14rpx 36rpx rgba(23, 107, 69, 0.18);
  color: #fff;
}

.summary-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-eyebrow,
.summary-label {
  display: block;
}

.summary-eyebrow {
  color: #c8edda;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
}

.summary-label {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.summary-amount {
  display: flex;
  align-items: baseline;
  margin-top: 18rpx;
  font-variant-numeric: tabular-nums;
}

.summary-currency {
  margin-right: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.summary-value {
  overflow-wrap: anywhere;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.25;
}

.summary-metrics {
  display: flex;
  margin: 30rpx -32rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(0, 0, 0, 0.08);
}

.summary-metric {
  min-width: 0;
  flex: 1;
  padding: 24rpx 12rpx 26rpx;
  text-align: center;
}

.summary-metric + .summary-metric {
  border-left: 1rpx solid rgba(255, 255, 255, 0.18);
}

.metric-value,
.metric-label {
  display: block;
}

.metric-value {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.metric-label {
  margin-top: 6rpx;
  color: #d7f0e2;
  font-size: 24rpx;
  line-height: 1.45;
}

.scope-note {
  display: flex;
  align-items: stretch;
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #eef7f1;
  color: #4f6258;
  font-size: 25rpx;
  line-height: 1.6;
}

.scope-accent {
  width: 5rpx;
  flex: none;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #16794a;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 40rpx 8rpx 16rpx;
}

.section-title {
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.section-desc {
  margin-left: 24rpx;
  color: #7a818c;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: right;
}

.moto-stat-card {
  width: 100%;
  display: block;
  margin: 0 0 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e2e5e9;
  border-radius: 24rpx;
  background: #fff;
  color: inherit;
  line-height: normal;
  text-align: left;
}

.moto-stat-card::after {
  border: 0;
}

.moto-stat-card--pressed {
  background: #f0f7f3;
}

.moto-heading {
  display: flex;
  align-items: center;
}

.moto-photo {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: 24rpx;
  background: #eef0f2;
}

.moto-photo--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f5ed;
  color: #16794a;
  font-size: 24rpx;
  font-weight: 700;
}

.moto-identity {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.moto-name,
.moto-plate {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.moto-name {
  color: #1f2329;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
}

.moto-plate {
  margin-top: 4rpx;
  color: #606770;
  font-size: 25rpx;
  line-height: 1.5;
}

.card-chevron {
  width: 16rpx;
  height: 16rpx;
  flex: none;
  margin-left: 20rpx;
  border-top: 3rpx solid #8a9099;
  border-right: 3rpx solid #8a9099;
  transform: rotate(45deg);
}

.moto-status {
  margin-top: 22rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #f3f5f7;
  color: #606770;
  font-size: 24rpx;
  line-height: 1.5;
}

.moto-status--error {
  background: #fff0ed;
  color: #9b3528;
}

.moto-metrics {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx -8rpx -8rpx;
}

.moto-metric {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
}

.moto-metric-value,
.moto-metric-label {
  display: block;
}

.moto-metric-value {
  overflow: hidden;
  color: #1f2329;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.moto-metric-label {
  margin-top: 2rpx;
  color: #7a818c;
  font-size: 24rpx;
  line-height: 1.5;
}

.skeleton {
  padding-top: 8rpx;
}

.skeleton-block {
  border-radius: 20rpx;
  background: #e7eaee;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}

.skeleton-hero {
  height: 320rpx;
}

.skeleton-title {
  width: 180rpx;
  height: 34rpx;
  margin-top: 44rpx;
}

.skeleton-card {
  height: 300rpx;
  margin-top: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes skeleton-pulse {
  from {
    opacity: 0.55;
  }

  to {
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .state-indicator,
  .refresh-indicator,
  .skeleton-block {
    animation: none;
  }
}

@media (prefers-color-scheme: dark) {
  .state-title,
  .section-title,
  .moto-name,
  .moto-metric-value {
    color: #f3f5f7;
  }

  .state-desc,
  .section-desc,
  .moto-plate,
  .moto-metric-label {
    color: #b6bbc3;
  }

  .state-indicator,
  .refresh-indicator {
    border-color: #315342;
    border-top-color: #68d49b;
  }

  .empty-bar {
    background: #315342;
  }

  .empty-bar--tall {
    background: #68d49b;
  }

  .load-notice {
    border-color: #6b592d;
    background: #3d341e;
  }

  .load-notice-text {
    color: #ead59c;
  }

  .load-notice-action {
    color: #8ce0b5;
  }

  .summary-card {
    background: #145b3c;
    box-shadow: none;
  }

  .scope-note {
    background: #1d3329;
    color: #b4c7bc;
  }

  .scope-accent {
    background: #68d49b;
  }

  .moto-stat-card {
    border-color: #3a3d42;
    background: #242629;
  }

  .moto-stat-card--pressed {
    background: #303a34;
  }

  .moto-photo {
    background: #34373b;
  }

  .moto-photo--fallback {
    background: #173c2d;
    color: #8ce0b5;
  }

  .card-chevron {
    border-color: #aeb4bd;
  }

  .moto-status {
    background: #303236;
    color: #b6bbc3;
  }

  .moto-status--error {
    background: #472824;
    color: #ffb4aa;
  }

  .skeleton-block {
    background: #34373b;
  }
}
